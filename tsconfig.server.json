{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist/server",
    "rootDir": "server",
    "noEmit": false,
    "sourceMap": true,
    "declaration": false
  },
  "include": [
    "server/index.ts",
    "server/types.ts",
    "server/agents/**/*.ts",
    "server/db/**/*.ts",
    "server/engine/**/*.ts"
  ]
}
